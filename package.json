{
  "name": "resume-maker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NEXT_TELEMETRY_DISABLED=1 next dev",
    "dev:turbo": "cross-env NEXT_TELEMETRY_DISABLED=1 next dev --turbopack",
    "dev:clean": "npm run clean && cross-env NEXT_TELEMETRY_DISABLED=1 next dev",
    "clean": "rimraf .next && rimraf node_modules/.cache",
    "build": "cross-env NEXT_TELEMETRY_DISABLED=1 next build",
    "build:fast": "cross-env NEXT_PRIVATE_SKIP_SIZE_ANALYSIS=1 NEXT_TELEMETRY_DISABLED=1 next build",
    "build:analyze": "cross-env ANALYZE=true NEXT_TELEMETRY_DISABLED=1 next build",
    "build:clean": "npm run clean && npm run build",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.1.1",
    "@libsql/client": "^0.15.9",
    "@react-pdf/renderer": "^4.3.0",
    "@sendgrid/mail": "^8.1.5",
    "@types/nodemailer": "^6.4.17",
    "bcryptjs": "^3.0.2",
    "critters": "^0.0.23",
    "formidable": "^3.5.4",
    "lucide-react": "^0.525.0",
    "mammoth": "^1.9.1",
    "next": "15.3.5",
    "nodemailer": "^7.0.4",
    "pdf-parse": "^1.1.1",
    "puppeteer": "^24.14.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.59.0",
    "react-to-print": "^3.1.1",
    "zod": "^3.25.73"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/formidable": "^3.4.5",
    "@types/node": "^20",
    "@types/pdf-parse": "^1.1.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^7.0.3",
    "eslint": "^9",
    "eslint-config-next": "15.3.5",
    "rimraf": "^6.0.1",
    "sharp": "^0.34.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
